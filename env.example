import React, { useState, useMemo } from 'react';
import { 
  Award, 
  Search, 
  Filter, 
  Calendar, 
  Clock, 
  Star, 
  ChevronRight, 
  SearchCode,
  Tag,
  ThumbsUp,
  Brain
} from 'lucide-react';
import { certificates, skills } from '../data';

export default function SkillsCertificates() {
  const [certFilterCategory, setCertFilterCategory] = useState<'all' | 'Finanças' | 'Administração' | 'Tecnologia' | 'Comunicação/Pessoal'>('all');
  const [certFilterYear, setCertFilterYear] = useState<'all' | 2019 | 2026>('all');
  const [certSearchQuery, setCertSearchQuery] = useState('');

  // Helper to parse 'DD/MM/YYYY' format to timestamp for accurate sorting
  const parseDate = (dateStr: string) => {
    const parts = dateStr.split('/');
    if (parts.length !== 3) return 0;
    const [day, month, year] = parts.map(Number);
    return new Date(year, month - 1, day).getTime();
  };

  // Filtering and Sorting Certificates based on Category, Year and Search Query
  const filteredCertificates = useMemo(() => {
    return certificates
      .filter(cert => {
        const matchesCategory = certFilterCategory === 'all' || cert.category === certFilterCategory;
        const matchesYear = certFilterYear === 'all' || cert.year === certFilterYear;
        const matchesSearch = cert.name.toLowerCase().includes(certSearchQuery.toLowerCase()) || 
                              cert.institution.toLowerCase().includes(certSearchQuery.toLowerCase());

        return matchesCategory && matchesYear && matchesSearch;
      })
      .sort((a, b) => {
        const timeA = parseDate(a.conclusionDate);
        const timeB = parseDate(b.conclusionDate);
        if (timeB !== timeA) return timeB - timeA;
        return b.id.localeCompare(a.id);
      });
  }, [certFilterCategory, certFilterYear, certSearchQuery]);

  // Aggregate Hours for filtered certificates
  const aggregatedHours = useMemo(() => {
    return filteredCertificates.reduce((acc, curr) => acc + curr.durationHours, 0);
  }, [filteredCertificates]);

  // Custom colors for certificate categories
  const categoryStyles: Record<string, { bg: string; text: string; bgSoft: string }> = {
    Finanças: { bg: 'bg-emerald-500', text: 'text-emerald-600', bgSoft: 'bg-emerald-50' },
    Administração: { bg: 'bg-indigo-500', text: 'text-indigo-600', bgSoft: 'bg-indigo-50' },
    Tecnologia: { bg: 'bg-cyan-500', text: 'text-cyan-600', bgSoft: 'bg-cyan-50' },
    'Comunicação/Pessoal': { bg: 'bg-purple-500', text: 'text-purple-600', bgSoft: 'bg-purple-50' },
  };

  return (
    <div className="p-4 sm:p-6 space-y-4 sm:space-y-6">
      
      {/* Grid: 2 Columns - Competency Matriz vs Certificates Repository */}
      <div className="grid grid-cols-1 lg:grid-cols-5 gap-6">
        
        {/* Left Side: Competency Matrix (2/5) */}
        <div className="bg-white rounded-2xl border border-slate-200/60 p-6 shadow-sm shadow-slate-100 lg:col-span-2 space-y-4 h-fit">
          <div className="flex items-center gap-2 border-b border-slate-100 pb-3">
            <Brain className="w-5 h-5 text-blue-600 shrink-0" />
            <div>
              <h3 className="font-bold text-slate-800 text-base leading-none">Matriz de Habilidades</h3>
              <span className="text-xs text-slate-400 mt-1 block">Nível prático em ferramentas e rotinas</span>
            </div>
          </div>

          <div className="space-y-4 pt-1">
            {skills.map((skill) => (
              <div key={skill.name} className="space-y-1.5 group select-none">
                <div className="flex items-center justify-between text-xs font-bold leading-none">
                  <span className="text-slate-700 font-sans group-hover:text-blue-600 transition-colors uppercase text-[10.5px] tracking-wide">
                    {skill.name}
                  </span>
                  <span className="bg-blue-50 text-blue-600 px-2 py-0.5 rounded font-mono text-[9px] tracking-wider uppercase">
                    {skill.level} ({skill.progress}%)
                  </span>
                </div>
                <div className="h-2 w-full bg-slate-50 border border-slate-100 rounded-full overflow-hidden flex p-0.5 group-hover:border-slate-200 transition-colors">
                  <div 
                    className="h-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full transition-all duration-300"
                    style={{ width: `${skill.progress}%` }}
                  ></div>
                </div>
              </div>
            ))}
          </div>

          <div className="bg-blue-50/30 rounded-xl p-3 border border-blue-100/30 text-xs text-slate-500 leading-relaxed font-sans mt-3 flex items-start gap-1.5">
            <ThumbsUp className="w-4 h-4 text-blue-600 shrink-0 mt-0.5" />
            <span>
              <strong>Perfis Combinados:</strong> Matriz integrada com faturamento de contas médicas, controle de fluxo de caixa, Excel Avançado e ferramentas BI.
            </span>
          </div>
        </div>

        {/* Right Side: Certificates Repository (3/5) */}
        <div className="bg-white rounded-2xl border border-slate-200/60 p-6 shadow-sm shadow-slate-100 lg:col-span-3 flex flex-col justify-between">
          <div className="space-y-4">
            
            {/* Header with quick stats */}
            <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-3">
              <div>
                <h3 className="font-bold text-slate-800 text-base leading-none flex items-center gap-2">
                  <Award className="w-5 h-5 text-blue-600 shrink-0" />
                  <span>Repositório de Qualificações</span>
                </h3>
                <span className="text-xs text-slate-400 mt-1 block">Qualificações e Certificados Ativos</span>
              </div>

              {/* Aggregated Hours counter for filtered results */}
              <div className="flex bg-slate-50 border border-slate-200/60 rounded-xl p-2.5 items-center gap-3 shrink-0">
                <div className="text-center border-r border-slate-200 pr-3">
                  <span className="text-[8px] text-slate-400 font-extrabold uppercase font-mono tracking-wider">Filtrados</span>
                  <div className="text-xs font-black text-slate-700 font-mono mt-0.5">{filteredCertificates.length} cursos</div>
                </div>
                <div className="text-center pl-1">
                  <span className="text-[8px] text-blue-600 font-extrabold uppercase font-mono tracking-wider">C.H. Total</span>
                  <div className="text-xs font-black text-blue-600 font-mono mt-0.5">{aggregatedHours}h</div>
                </div>
              </div>
            </div>

            {/* Searching Certificates */}
            <div className="relative">
              <input
                type="text"
                placeholder="Pesquisar por título de qualificação..."
                value={certSearchQuery}
                onChange={(e) => setCertSearchQuery(e.target.value)}
                className="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-slate-700 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/25 transition-all font-semibold"
              />
              <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" />
            </div>

            {/* Quick Year filter & Category Filters row */}
            <div className="flex flex-wrap items-center gap-2 border-b border-slate-50 pb-3">
              
              {/* Year Select Toggle */}
              <div className="flex bg-slate-100 rounded-lg p-0.5 border border-slate-200/60 text-[11px] font-bold text-slate-600">
                <button
                  onClick={() => setCertFilterYear('all')}
                  className={`px-2 py-1 rounded-md transition-all cursor-pointer ${
                    certFilterYear === 'all' ? 'bg-white text-slate-800 shadow-sm' : 'hover:text-slate-800'
                  }`}
                >
                  Ver Todos
                </button>
                <button
                  onClick={() => setCertFilterYear(2019)}
                  className={`px-2 py-1 rounded-md transition-all cursor-pointer ${
                    certFilterYear === 2019 ? 'bg-white text-slate-800 shadow-sm' : 'hover:text-slate-800'
                  }`}
                >
                  2019
                </button>
                <button
                  onClick={() => setCertFilterYear(2026)}
                  className={`px-2 py-1 rounded-md transition-all cursor-pointer ${
                    certFilterYear === 2026 ? 'bg-white text-slate-800 shadow-sm' : 'hover:text-slate-800'
                  }`}
                >
                  2026
                </button>
              </div>

              {/* Tag/Category dropdown selector or buttons list */}
              <div className="flex flex-wrap gap-1.5">
                {(['all', 'Finanças', 'Administração', 'Tecnologia', 'Comunicação/Pessoal'] as const).map((cat) => {
                  const style = categoryStyles[cat] || { bg: 'bg-blue-600', text: 'text-slate-600', bgSoft: 'bg-slate-50 border-slate-200/60' };
                  const isSelected = certFilterCategory === cat;

                  return (
                    <button
                      key={cat}
                      onClick={() => setCertFilterCategory(cat)}
                      className={`px-2.5 py-1 rounded-full text-[10px] font-extrabold tracking-tight cursor-pointer border transition-all ${
                        isSelected
                          ? `${style.bg} text-white border-transparent shadow-sm`
                          : 'bg-white border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50/50'
                      }`}
                    >
                      {cat === 'all' ? 'Todas Áreas' : cat}
                    </button>
                  );
                })}
              </div>

            </div>

            {/* List content of filtered certificates */}
            {filteredCertificates.length === 0 ? (
              <div className="bg-slate-50/30 rounded-xl p-8 border border-slate-100 text-center font-sans">
                <Award className="w-10 h-10 text-slate-300 mx-auto mb-2" />
                <h4 className="font-bold text-slate-600 text-xs text-center">Nenhum certificado para o filtro selecionado</h4>
                <p className="text-[10px] text-slate-400 mt-0.5">Tente limpar os filtros gerais de ano ou categoria.</p>
              </div>
            ) : (
              <div className="space-y-2.5 max-h-120 overflow-y-auto pr-1">
                {filteredCertificates.map((cert) => {
                  const style = categoryStyles[cert.category];

                  return (
                    <div 
                      key={cert.id} 
                      className="group border border-slate-100 rounded-xl p-3 hover:border-slate-200 hover:bg-slate-50/30 transition-all flex items-center justify-between gap-3 bg-white"
                    >
                      <div className="min-w-0 flex-1 flex gap-3 items-start">
                        {/* Categorization marker tag */}
                        <span className={`w-1.5 h-10 rounded-full shrink-0 mt-0.5 ${style.bg}`}></span>
                        <div className="min-w-0 flex-1">
                          <h4 className="text-xs font-black text-slate-700 group-hover:text-blue-600 transition-colors truncate font-sans">
                            {cert.name}
                          </h4>
                          <div className="flex items-center gap-1.5 mt-0.5 select-none">
                            {cert.institution.toLowerCase().includes('bradesco') ? (
                              <img 
                                src="https://img.icons8.com/color/1200/bradesco.jpg" 
                                alt="Fundação Bradesco" 
                                className="w-3.5 h-3.5 object-cover rounded-xs shrink-0"
                                referrerPolicy="no-referrer"
                              />
                            ) : cert.institution.toLowerCase().includes('dio') ? (
                              <img 
                                src="https://assets.dio.me/VTgUqMiPAIgvsFdSvgSnVAB5lrqnNxY_N8h8LknnQys/f:webp/q:80/w:120/L2Fzc2V0cy9kaW9tZS9sb2dvLWZ1bGwuc3Zn" 
                                alt="DIO" 
                                className="h-2.5 object-contain shrink-0"
                                referrerPolicy="no-referrer"
                              />
                            ) : null}
                            <span className="text-[10px] text-slate-400 font-semibold block truncate">
                              {cert.institution}
                            </span>
                          </div>
                        </div>
                      </div>

                      <div className="shrink-0 flex items-center gap-3">
                        <div className="text-right select-none">
                          <span className={`text-[10px] uppercase font-black tracking-wide ${style.text} ${style.bgSoft} px-2 py-0.5 rounded-full inline-block`}>
                            {cert.category === 'Comunicação/Pessoal' ? 'Comunicação' : cert.category}
                          </span>
                          <span className="text-[10px] font-mono text-slate-400 font-semibold block mt-1">
                            Anual: {cert.year}
                          </span>
                        </div>

                        <div className="w-11 h-11 rounded-lg bg-blue-50 grid place-content-center text-center select-none shadow-sm shadow-blue-500/5">
                          <span className="text-xs font-black text-blue-600 leading-none">{cert.durationHours}</span>
                          <span className="text-[8px] text-blue-400 font-bold block mt-0.5">horas</span>
                        </div>
                      </div>

                    </div>
                  );
                })}
              </div>
            )}

          </div>

          <div className="pt-4 mt-4 border-t border-slate-100 text-[10px] text-slate-400 font-mono tracking-wider uppercase text-right leading-none select-none">
            Múltiplas Plataformas de Ensino • Titulação de Formações Livres Completas
          </div>

        </div>

      </div>

    </div>
  );
}
